  "game_save_sequence": {
    "description": "From END.bas - saves three files",
    "files": [
      {
        "command": "BSAVE P/F,A$97E1,L$140",
        "file": "p_f",
        "address": "38881",
        "length": "320"
      },
      {
        "command": "BSAVE PLANET FILE,A$954C,L$AF",
        "file": "planet_file",
        "address": "38220",
        "length": "175"
      },
      {
        "command": "BSAVE SHIP'S DATA,A$38150,L$36",
        "file": "ships_data",
        "address": "229712",
        "length": "54"
      }
    ],
    "pre_save_operation": "Copies data from $29467-$29475 to $38211-$38219"
  },
  "dynamic_game_state": {
    "description": "Game state variables stored in memory during gameplay",
    "addresses": {
      "$95FD": {
        "decimal": 38397,
        "type": "uint8",
        "description": "Joystick 1 value (paddle port 1)",
        "source": "STARSHIP SIMULATOR.bas line 7: J = PDL(1): POKE 38397,J"
      },
      "$95FE": {
        "decimal": 38398,
        "type": "uint8",
        "description": "Joystick 0 value (paddle port 0)",
        "source": "STARSHIP SIMULATOR.bas line 7: K = PDL(0): POKE 38398,K"
      },
      "$95F7": {
        "decimal": 38391,
        "type": "uint8",
        "description": "Copy protection check - original value is ASCII 'M' (77)",
        "source": "START.bas line 26: OG = PEEK(38391): POKE 38391,0: IF OG = 77 THEN PRINT \"BSAVE PLANET FILE,A$954C,L$AF\""
      }
    }
  },
