  "files": {
    "p_f": {
      "filename": "P_F.payload.bin",
      "load_address": "38881",
      "size": 320,
      "description": "Planet/Starbase data - 20 records of 16 bytes each",
      "record_format": {
        "size": 16,
        "fields": [
          {"name": "word_a", "offset": 0, "size": 2, "type": "uint16le", "description": "Unknown word value A"},
          {"name": "word_b", "offset": 2, "size": 2, "type": "uint16le", "description": "Unknown word value B"},
          {"name": "flag", "offset": 4, "size": 1, "type": "uint8", "description": "Record flag (0 or 1)"},
          {"name": "record_id", "offset": 5, "size": 1, "type": "uint8", "description": "Record ID (1-20)"},
          {"name": "reserved", "offset": 6, "size": 10, "type": "bytes", "description": "Additional data (usually zeros)"}
        ]
      },
      "records_with_flag_1": [1, 4, 7, 8, 11, 12, 15],
      "records_with_flag_0": [2, 3, 5, 6, 9, 10, 13, 14, 16, 17, 18, 19, 20]
    },
    "planet_file": {
      "filename": "PLANET FILE.payload.bin",
      "load_address": "38220",
      "size": 175,
      "description": "Current planet state/visited status",
      "notes": "Uninitialized template contains FF FF 01 01 repeated pattern",
      "template_file": "PLANET FILE-M.payload.bin",
      "template_fields": [
        {"name": "planet_count", "offset": 0, "size": 1, "type": "uint8", "description": "Likely planet count or index"},
        {"name": "unknown_21", "offset": 21, "size": 1, "type": "uint8", "description": "Matches P_F record 0 byte 4"},
        {"name": "various_data", "offset": 32, "size": "variable", "type": "mixed", "description": "Various data values"}
      ]
    },
    "ships_data": {
      "filename": "SHIP'S DATA-M.payload.bin",
