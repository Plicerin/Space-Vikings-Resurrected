{
  "name": "space-vikings-remake",
  "version": "0.1.0",
  "description": "Modern JavaScript remake of Space Vikings (1982 Apple II game)",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Plicerin/Space-Vikings-Resurrected.git"
  },
  "keywords": [
    "space-vikings",
    "apple-ii",
    "retro-gaming",
    "javascript",
    "emulator",
    "remake"
  ],
  "author": "Space Vikings Resurrected Project",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Plicerin/Space-Vikings-Resurrected/issues"
  },
  "homepage": "https://github.com/Plicerin/Space-Vikings-Resurrected#readme",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.4",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "babel-loader": "^10.1.1",
    "gh-pages": "^6.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/tests/__mocks__/fileMock.js"
    }
  }
}
